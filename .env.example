# Copy this file to .env and fill in your own values. NEVER commit .env.
# Stage 3 (RDAP) and the Markbase search endpoint need no key at all.

# --- Optional: TypeSafe / Jev scoring backend (only for score-jev) ----------
# Get one from the TypeSafe console: https://console.typesafe.ai
TYPESAFE_API_KEY=""
# TYPESAFE_API_KEY is read only by namefinder.jev; it is never printed.

# --- OpenRouter: used by every LLM stage (ideas, generate, tournament, score...) ---
# The default model costs fractions of a cent per call; every paid command takes --max-cost.
OPENROUTER_API_KEY=""
# Optional model override (default shown):
# OPENROUTER_MODEL="z-ai/glm-5.3-flash"

# --- Stage 4: optional upgrades -------------------------------------------
# A Markbase key unlocks the 25-name batch clearance endpoint.
MARKBASE_API_KEY=""
# A GitHub token raises search from 60 req/h to 30 req/min.
GITHUB_TOKEN=""

# --- Optional overrides ---------------------------------------------------
# NAMEFINDER_DB="data/namefinder.db"
# NAMEFINDER_PROMPTS="prompts"        # your prompt set; try examples/image-provenance
# TYPESAFE_MODEL="jev-latest"

# Use another OpenAI-compatible provider (e.g. Nous) for the generation stages only
# (ideas, generate, evolve, LLM coining); scoring, refine and tournament stay on OpenRouter:
# NAMEFINDER_GEN_URL="https://inference-api.nousresearch.com/v1"
# NAMEFINDER_GEN_KEY_ENV="NOUS_API_KEY"   # name of the variable below that holds the key
# NOUS_API_KEY=""
# OPENROUTER_IDEAS_MODEL="<model id from the provider's /models list>"
# OPENROUTER_NAMEGEN_MODEL="<same>"
# OPENROUTER_COIN_MODEL="<same>"
# NAMEFINDER_LLM_URL / NAMEFINDER_LLM_KEY_ENV do the same for every stage, scoring included.

# Optional OpenRouter routing (reasoning is off by default)
# OPENROUTER_PROVIDER="Relace"
# OPENROUTER_REASONING=low   # low|minimal|medium|high|off|on
# OPENROUTER_COIN_MODEL="z-ai/glm-5.3-flash"     # model that invents names for LLM coining (default: OPENROUTER_MODEL)
# OPENROUTER_REFINE_MODEL="z-ai/glm-5.3-flash"   # defaults to OPENROUTER_MODEL
