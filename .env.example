# Copy this file to .env and fill in your own values. NEVER commit .env.
# Stage 3 (RDAP) and the Markbase search endpoint need no key at all.

# --- Stage 2: TypeSafe / Jev (required for score-jev) ----------------------
# Get one from the TypeSafe console: https://console.typesafe.ai
TYPESAFE_API_KEY=""
# TYPESAFE_API_KEY is read only by namefinder.jev; it is never printed.

# --- Stage 5: OpenRouter (required for rank-final) -------------------------
# Free tier is ~50 requests/day, so this stage uses at most 2 calls.
OPENROUTER_API_KEY=""
# Optional model override (default shown):
# OPENROUTER_MODEL="z-ai/glm-5.3-flash"

# --- Stage 4: optional upgrades -------------------------------------------
# A Markbase key unlocks the 25-name batch clearance endpoint.
MARKBASE_API_KEY=""
# A GitHub token raises search from 60 req/h to 30 req/min.
GITHUB_TOKEN=""

# --- Optional overrides ---------------------------------------------------
# NAMEFINDER_DB="data/namefinder.db"
# TYPESAFE_MODEL="jev-latest"

# Optional OpenRouter routing (reasoning is off by default)
# OPENROUTER_PROVIDER="Relace"
# OPENROUTER_REASONING=low   # low|minimal|medium|high|off|on
# OPENROUTER_REFINE_MODEL="z-ai/glm-5.3-flash"   # defaults to OPENROUTER_MODEL
